                "https://www.g2.com/products/codecave/expertises",
                "https://glassdoor.com/Reviews/Employee-Review-CodeCave-E8324784-RVW95188942.htm",
                "https://upcity.com/profiles/codecave-llc",
                "https://www.trustpilot.com/review/codecave.pro"
            ],
            "knowsLanguage": [
                "en",
                "ru",
                "it"
            ],
            "hasCredential": [
                {
                    "@type": "EducationalOccupationalCredential",
                    "name": "HubSpot Partner",
                    "credentialCategory": "Certification",
                    "recognizedBy": {
                        "@type": "Organization",
                        "name": "HubSpot",
                        "url": "https://www.hubspot.com"
                    }
                },
                {
                    "@type": "EducationalOccupationalCredential",
                    "name": "Microsoft Partner",
                    "credentialCategory": "Certification",
                    "recognizedBy": {
                        "@type": "Organization",
                        "name": "Microsoft",
                        "url": "https://www.microsoft.com/"
                    }
                },
                {
                    "@type": "EducationalOccupationalCredential",
                    "name": "AWS Partner",
                    "credentialCategory": "Certification",
                    "recognizedBy": {
                        "@type": "Organization",
                        "name": "AWS",
                        "url": "https://aws.amazon.com/"
                    }
                },
                {
                    "@type": "EducationalOccupationalCredential",
                    "name": "Autodesk Partner",
                    "credentialCategory": "Certification",
                    "recognizedBy": {
                        "@type": "Organization",
                        "name": "Autodesk",
                        "url": "https://www.autodesk.com/"
                    }
                },
            ],
        },
        {
            "@type": "WebSite",
            "@id": "https://codecave.it/#website",
            "url": "https://codecave.it",
            "name": "CodeCave",
            "publisher": {"@id": "https://codecave.it/#organization"},
        },
        {
            "@type": "LocalBusiness",
            "@id": "https://codecave.it/#localbusiness",
            "parentOrganization": {"@id": "https://codecave.it/#organization"},
            "name": "CodeCave LLC",
            "url": "https://codecave.it",
            "image": "https://codecave.it/logo.svg",
            "taxID": "35-2654711",
            "telephone": "+1-302-364-0193",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "8 The Green STE B",
                "addressLocality": "Dover",
                "addressRegion": "DE",
                "postalCode": "19901-3618",
                "addressCountry": "US"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 39.156568,
                "longitude": -75.524196
            },
            "openingHoursSpecification": {
                "@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                    "Monday",
                    "Tuesday",
                    "Wednesday",
                    "Thursday",
                    "Friday"
                ],
                "opens": "09:00",
                "closes": "18:00"
            },
        },
    ]
