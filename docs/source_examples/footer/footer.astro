---

<footer class="bg-surface-primary">
    <div class="page-container pt-6 pb-4 xl:pt-14 xl:pb-8">
        <div class="pb-16 border-b border-surface-quaternary flex flex-col gap-4 md:flex-row justify-between">
            <div class="space-y-2">
                <h3 class="text-xl font-bold text-heading">Grab our AI trends research!</h3>
                <p class="text-body-secondary-lighter text-sm max-w-66">
                    We’ve researched current state of the AI in 5+ industries so you don’t have to. 
                    <br> 
                    Check what we’ve found about yours.
                </p>
            </div>
            <ResearchFormAstroComponent client:load/>
        </div>
        <div class="flex flex-col gap-16 xl:flex-row justify-between border-b border-surface-quaternary py-11">
            <div class="order-last xl:order-none space-y-8">
                <address class="text-sm not-italic text-body-secondary-lighter space-y-2">
                    <div>
                        <p>EIN: 35-2654711 Company Code: 7296176</p>
                        <p>8 The Green STE B Dover, DE 19901-3618</p>
                        <p>United States</p>
                    </div>
                    <Button
                            as="link"
                            variant="text"
                            title={'+1 302 364 0193'}
                            href="tel:+1 302 364 0193"
                    />
                </address>
                <div class="flex gap-5">
                    {socialMedia.map(item => (
                            <a
                                    href={item.link}
                                    target="_blank"
                                    rel='noopener noreferrer'
                                    class="transition-all w-5 h-5 text-default-transparent hover:text-action"
                            >
                                <Icon name={item.icon} />
                            </a>
                    ))}
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-5 xl:flex flex-wrap gap-8 xl:gap-16">
                <LinkGroup groupName="Services" items={services} />
                <LinkGroup groupName="Industries" items={industries} />
                <LinkGroup groupName="Other" items={other} />
                <LinkGroup groupName="Reviews" items={reviews} />
                <LinkGroup groupName="Legal" items={legal} />
            </div>
        </div>
        <div class="flex flex-wrap justify-between xl:justify-center gap-3 xl:gap-16 items-center pt-8 xl:pt-11">
            <LazyImage
                    class="h-12 w-12 xl:h-16 xl:w-16"
                    src={Hubspot.src}
                    alt={"Hubspot partner"}
                    client:load
            />
            <LazyImage
                    class="h-6 xl:h-8"
                    src={Microsoft.src}
                    alt={"Microsoft partner"}
                    client:load
            />
            <LazyImage
                    class="h-6 xl:h-8"
                    src={AWS.src}
                    alt={"AWS partner"}
                    client:load
            />
            <LazyImage
                    class="h-6 xl:h-8"
                    src={Autodesk.src}
                    alt={"Autodesk partner"}
                    client:load
            />
        </div>
    </div>
</footer>

<script is:inline type="application/ld+json" set:html={JSON.stringify(mainPageSchema)} />
