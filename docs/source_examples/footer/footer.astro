---
import Icon from "../../assets/icons/Icon.astro";
import Autodesk from "../../assets/images/autodesk-partner.png";
import AWS from "../../assets/images/aws-partner.png";
import Hubspot from "../../assets/images/hubspot-partner.png";
import Microsoft from "../../assets/images/microsoft-partner.png";
import Button from "../common/Button.vue";
import ResearchFormAstroComponent from "../common/forms/ResearchForm.vue";
import LazyImage from "../common/images/LazyImage.vue";
import LinkGroup from "./link-group.vue";
import { industries, legal, other, reviews, services } from "./links.ts";

const socialMedia = [
    {link: 'https://t.me/CodeCaveConstactUsBot', icon: 'telegram'},
    {link: 'https://www.linkedin.com/company/codecave/about/', icon: 'linkedin'},
    {link: 'https://wa.me/13023640193', icon: 'whatsapp'},
]
const mainPageSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": "https://codecave.it/#organization",
            "name": "CodeCave",
            "url": "https://codecave.it",
            "logo": "https://codecave.it/logo.svg",
            "contactPoint": {
                "@type": "ContactPoint",
                "telephone": "+1-302-364-0193",
                "contactType": "sales",
                "email": "hello@codecave.pro"
            },
            "sameAs": [
                "https://www.pinterest.com/codecave_pro",
                "https://t.me/codecave_pro",
                "https://www.facebook.com/codecave.company",
                "https://www.youtube.com/@codecave_pro",
                "https://x.com/codecave_pro",
                "https://vk.com/codecave_pro",
