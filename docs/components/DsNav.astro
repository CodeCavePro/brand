---
/* The global documentation bar. One copy, on every rendered page.
 *
 * It renders BrandNav, the package's own bar, rather than markup of its own.
 * That is the point of the component: this file used to be a hand-kept copy of
 * the site header, and ds-nav.css a hand-kept copy of its styles, so the docs
 * site demonstrated a bar that nothing shipped. Now the docs run the same
 * component a consumer installs, which is the only arrangement in which a
 * change to the bar can be seen here before it reaches anyone.
 *
 * It is also the first thing to exercise @astrojs/vue, which astro.config.mjs
 * has carried unused since the migration. No `client:*` directive: BrandNav
 * emits static HTML and ships no JavaScript, exactly as the old markup did.
 *
 * `up` comes from the layout rather than being computed here, because the
 * layout needs the same prefix for its stylesheet hrefs and computing it twice
 * is how the two drift apart. Relative rather than root-absolute so a page
 * still opens from disk — which is how these cards are reviewed.
 *
 * The six artifact specimens deliberately have no nav at all: an HTML email
 * with a documentation bar welded to the top is no longer a valid email. Only
 * artifacts/index.html, the gallery, carries this.
 */
import BrandNav from '../authored/common/BrandNav.vue';

interface Props {
  /** Which section is being viewed, or nothing on a page in none of them. */
  current?: 'brand-kit' | 'foundations' | 'storybook' | 'artifacts';
  /** '../' repeated once per directory level below the docs root. */
  up: string;
}

const { current, up } = Astro.props;

/* The section each item stands for is not its label, so `current` is matched
   against these names and the labels are free to change. */
const left = [
  { name: 'brand-kit', label: 'Brand kit', href: `${up}brand-kit.html` },
  { name: 'foundations', label: 'Foundations', href: `${up}preview/index.html` },
];
const right = [
  { name: 'storybook', label: 'Live components', href: `${up}storybook/index.html` },
  { name: 'artifacts', label: 'Templates', href: `${up}artifacts/index.html` },
];
---
<BrandNav
  left={left.map((i) => ({ name: i.label, href: i.href }))}
  right={right.map((i) => ({ name: i.label, href: i.href }))}
  current={[...left, ...right].find((i) => i.name === current)?.label}
  logo={`${up}assets/codecave-wide.svg`}
  logoHref={`${up}index.html`}
  logoAlt="CODECAVE"
  logoLabel="CODECAVE design system — documentation home"
/>
