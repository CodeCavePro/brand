---
/* The global documentation bar. One copy, replacing the fourteen identical
 * lines that sit in 30 HTML files today, varying only by `../` depth and which
 * link carries aria-current.
 *
 * The markup below is the markup those files already ship, character for
 * character. That is deliberate: while the migration is half-done, a ported
 * page and an unported page render side by side under the same ds-nav.css, and
 * any difference here would show up as the two halves of the site disagreeing
 * about their own chrome.
 *
 * `up` comes from the layout rather than being computed here, because the
 * layout needs the same prefix for its stylesheet hrefs and computing it twice
 * is how the two drift apart. Relative rather than root-absolute so a page
 * still opens from disk — which is how these cards are reviewed.
 *
 * The six artifact specimens deliberately have no nav at all: an HTML email
 * with a documentation bar welded to the top is no longer a valid email.
 * ds-nav.css says so in its own header, and artifacts/ is never rendered by
 * Astro anyway. Only artifacts/index.html, the gallery, carries this.
 */
interface Props {
  /** Which section is being viewed, or nothing on a page in none of them. */
  current?: 'brand-kit' | 'foundations' | 'storybook' | 'artifacts';
  /** '../' repeated once per directory level below the docs root. */
  up: string;
}

const { current, up } = Astro.props;
const here = (section: Props['current']) => (section === current ? 'page' : undefined);
---
<nav class="ds-nav" aria-label="Design system">
  <div class="page-container ds-nav-inner">
    <ul>
      <li><a class="btn btn-ghost" href={`${up}brand-kit.html`} aria-current={here('brand-kit')}>Brand kit</a></li>
      <li><a class="btn btn-ghost" href={`${up}preview/index.html`} aria-current={here('foundations')}>Foundations</a></li>
    </ul>
    <a class="ds-nav-logo" href={`${up}index.html`} aria-label="CODECAVE design system — documentation home">
      <img src={`${up}assets/codecave-wide.svg`} alt="CODECAVE"></a>
    <ul>
      <li><a class="btn btn-ghost" href={`${up}storybook/index.html`} aria-current={here('storybook')}>Live components</a></li>
      <li><a class="btn btn-ghost" href={`${up}artifacts/index.html`} aria-current={here('artifacts')}>Templates</a></li>
    </ul>
  </div>
</nav>
