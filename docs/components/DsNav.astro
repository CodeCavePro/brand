---
/* The global documentation bar. One copy, on every rendered page.
 *
 * It renders BrandNav, the package's own bar, rather than markup of its own.
 * That is the point of the component: this file used to be a hand-kept copy of
 * the site header, and ds-nav.css a hand-kept copy of its styles, so the docs
 * site demonstrated a bar that nothing shipped. Now the docs run the same
 * component a consumer installs, which is the only arrangement in which a
 * change to the bar can be seen here before it reaches anyone.
 *
 * It is also the first thing to exercise @astrojs/vue, which astro.config.mjs
 * has carried unused since the migration. No `client:*` directive: BrandNav
 * emits static HTML and ships no JavaScript, exactly as the old markup did.
 *
 * THE ITEMS ARE NOT WRITTEN HERE ANY MORE. They were, until the site collapsed
 * to two surfaces; menu.ts owns them now, and this file owns only how they are
 * handed to BrandNav. A page cannot pass items in -- there is no prop -- so
 * "the main menu is the same on every page" is true by construction rather than
 * by everyone remembering. The one thing a page contributes is which item is
 * current, and that is a name out of menu.ts rather than a string of its own.
 *
 * `up` comes from the layout rather than being computed here, because the
 * layout needs the same prefix for its stylesheet hrefs and computing it twice
 * is how the two drift apart. Relative rather than root-absolute so a page
 * still opens from disk -- which is how these pages are reviewed.
 *
 * The six artifacts under examples/ deliberately have no nav at all: an HTML
 * email with a documentation bar welded to the top is no longer a valid email,
 * and a deck would repeat it on every slide. Each is reached through a wrapper
 * PAGE that carries this bar, so every route has the menu while every artifact
 * stays the thing it demonstrates.
 */
import BrandNav from '../authored/common/BrandNav.vue';
import { MAIN, UNLISTED, assertMenu } from './menu.ts';

interface Props {
  /** A MAIN item name, or nothing on a page in no section. */
  current?: string;
  /** '../' repeated once per directory level below the docs root. */
  up: string;
}

const { current, up } = Astro.props;

assertMenu();

/* An unknown `current` would render a bar with nothing marked, which is
   indistinguishable from a page legitimately outside every section -- so a
   typo is worth failing on. An UNLISTED name passes and marks nothing, which
   is correct rather than a loophole: `home` is a real section with a real
   second bar, and the wordmark is its entry in this one. */
const known = [...MAIN.map((i) => i.name), ...UNLISTED];
if (current && !known.includes(current)) {
  throw new Error(
    `DsNav: no section named "${current}".\n` +
      `Known sections are: ${known.join(', ')}`,
  );
}

/* BrandNav splits its items around the centred wordmark. With two surfaces that
   is one per side, and the split is arithmetic rather than a layout decision
   taken here -- a third surface would fall out of the same line. */
const half = Math.ceil(MAIN.length / 2);
const toNav = (i: (typeof MAIN)[number]) => ({ name: i.label, href: `${up}${i.href}` });
---
<BrandNav
  left={MAIN.slice(0, half).map(toNav)}
  right={MAIN.slice(half).map(toNav)}
  current={MAIN.find((i) => i.name === current)?.label}
  logo={`${up}assets/codecave-wide.svg`}
  logoHref={`${up}index.html`}
  logoAlt="CODECAVE"
  logoLabel="CODECAVE design system — documentation home"
/>
