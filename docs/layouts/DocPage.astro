---
/* The shell every documentation page shares: the head, the token stylesheets,
 * the nav, the body. It emits what the 30 hand-written pages emit today.
 *
 * WHY THE PATHS ARE RELATIVE. `up` is derived from the page's own URL, so a
 * page one directory down gets '../' and a page at the root gets ''. Root-
 * absolute hrefs would be simpler and would be wrong for this repository: the
 * doc pages are reviewed by opening them from disk, and the unported half of
 * the site still links relatively. Under 'preserve' the pathname is
 * '/preview/foo.html' for a normal page and '/preview/' for an index page —
 * stripping the last segment handles both without a special case.
 *
 * Page-specific CSS goes in through the `head` slot as <style is:inline>.
 * `is:inline` is load-bearing: Astro's default is to scope a component's <style>
 * by rewriting its selectors, which would quietly break rules like .glow-stage
 * that the page's own markup relies on.
 */
import DsNav from '../components/DsNav.astro';

interface Props {
  /** Full <title>, including the "CODECAVE — " prefix the pages already use. */
  title: string;
  /** Which nav section to mark current. Omit on a page in none of them. */
  nav?: 'brand-kit' | 'foundations' | 'storybook' | 'artifacts';
  /** Extra stylesheets, resolved relative to the page (e.g. "preview.css"). */
  stylesheets?: string[];
  /** Emit the vendored-ESM import map. Every storybook page that mounts a
   *  compiled component needs it, and all thirteen ship the same nine lines. */
  importmap?: boolean;
}

const { title, nav, stylesheets = [], importmap = false } = Astro.props;

/* `title` is plain text — {title} escapes it on the way out. Passing HTML
 * already escaped, which is how it is written in the .html pages this layout
 * replaces, escapes it a second time and puts a literal "&amp;" in the browser
 * tab. Porting components-progress.html did exactly that, and it survived
 * everything except diffing the rendered page against the file it replaced.
 * Not everyone will run that diff, so the build refuses the input instead. */
if (/&(#\d+|#x[0-9a-fA-F]+|[a-zA-Z][a-zA-Z0-9]*);/.test(title)) {
  throw new Error(
    `DocPage: title contains an HTML entity and would be escaped twice —\n` +
      `  ${title}\n` +
      `Write the character itself; the layout escapes it.`,
  );
}

const dir = Astro.url.pathname.replace(/^\//, '').replace(/[^/]*$/, '');
const up = '../'.repeat((dir.match(/\//g) ?? []).length);

/* The import map is the one piece of head that cannot be written as ordinary
 * markup here. Astro does not evaluate {expressions} inside a <script>, so the
 * `up` prefix has to arrive through set:html — and the tag needs is:inline as
 * well, or Astro takes ownership of the script and the map stops being a map.
 *
 * It maps the three bare specifiers the compiled components import. Those files
 * are esbuild output from the site's own toolchain, externalised rather than
 * bundled, so `import { createApp } from 'vue'` survives into the browser and
 * something has to resolve it. Deliberately the vendored copies under
 * docs/vendor/ and NOT the npm ones: a specimen has to render the same when the
 * page is opened from disk, and the vendored vue is the esm-browser build that
 * ships the runtime compiler, which several stories need for slot content. */
const importmapJson = `
{
  "imports": {
    "vue": "${up}vendor/vue.esm-browser.prod.js",
    "gsap": "${up}vendor/gsap/index.js",
    "gsap/dist/SplitText": "${up}vendor/gsap/SplitText.js"
  }
}
`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="icon" href={`${up}build/favicon.svg`}>
<link rel="stylesheet" href={`${up}colors_and_type.css`}>
<link rel="stylesheet" href={`${up}ds-nav.css`}>
{stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
<slot name="head" />
{importmap && <script type="importmap" is:inline set:html={importmapJson} />}
</head>
<body>

<DsNav current={nav} up={up} />

<slot />

</body>
</html>
