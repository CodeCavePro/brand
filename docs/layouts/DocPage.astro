---
/* The shell every documentation page shares: the head, the token stylesheets,
 * the nav, the body. It emits what the 30 hand-written pages emit today.
 *
 * WHY THE PATHS ARE RELATIVE. `up` is derived from the page's own URL, so a
 * page one directory down gets '../' and a page at the root gets ''. Root-
 * absolute hrefs would be simpler and would be wrong for this repository: the
 * doc pages are reviewed by opening them from disk, and the unported half of
 * the site still links relatively. Under 'preserve' the pathname is
 * '/kitchen-sink/foo.html' for a normal page and '/kitchen-sink/' for an index page —
 * stripping the last segment handles both without a special case.
 *
 * Page-specific CSS goes in through the `head` slot as <style is:inline>.
 * `is:inline` is load-bearing: Astro's default is to scope a component's <style>
 * by rewriting its selectors, which would quietly break rules like .glow-stage
 * that the page's own markup relies on.
 */
import DsNav from '../components/DsNav.astro';
import SubNav from '../components/SubNav.astro';

interface Props {
  /** Full <title>, including the "CODECAVE — " prefix the pages already use. */
  title: string;
  /** Which nav section to mark current. Omit on a page in none of them. */
  nav?: string;
  /** Which SUB item to mark, for a section whose second bar is sibling pages.
   *  Omit inside a single-page section, where the bar is in-page anchors and
   *  nothing is "current" until the reader scrolls. */
  sub?: string;
  /** Extra stylesheets, resolved relative to the page (e.g. "preview.css"). */
  stylesheets?: string[];
  /** Emit the vendored-ESM import map. Every storybook page that mounts a
   *  compiled component needs it, and all thirteen ship the same nine lines. */
  importmap?: boolean;
}

const { title, nav, sub, stylesheets = [], importmap = false } = Astro.props;

/* `title` is plain text — {title} escapes it on the way out. Passing HTML
 * already escaped, which is how it is written in the .html pages this layout
 * replaces, escapes it a second time and puts a literal "&amp;" in the browser
 * tab. Porting components-progress.html did exactly that, and it survived
 * everything except diffing the rendered page against the file it replaced.
 * Not everyone will run that diff, so the build refuses the input instead. */
if (/&(#\d+|#x[0-9a-fA-F]+|[a-zA-Z][a-zA-Z0-9]*);/.test(title)) {
  throw new Error(
    `DocPage: title contains an HTML entity and would be escaped twice —\n` +
      `  ${title}\n` +
      `Write the character itself; the layout escapes it.`,
  );
}

/* How far this page sits below the site root. Every URL in this head is built
 * from it, and it cannot be read off the request path: a directory index is
 * served at `/storybook` by dev and emitted as `/kitchen-sink/` by the build, so
 * the same page counts one level in one mode and none in the other. That is
 * CCWEB2-336 — it left /kitchen-sink/ and /kitchen-sink/ with no stylesheets and, on
 * the storybook, an import map whose values were bare specifiers the browser
 * discarded, so no specimen mounted. Nothing was wrong with the built pages,
 * which is why it survived.
 *
 * `/preview` and `/brand-kit` are the same shape and different depths, so no
 * amount of squinting at the URL separates them. Depth is a fact about where
 * the page's SOURCE sits, so ask the source tree. import.meta.glob is resolved
 * by Vite at transform time, so this is a static list in both modes and not a
 * filesystem read — the layout is a bundled chunk by the time it runs. */
const INDEX_ROUTES = new Set(
  Object.keys(import.meta.glob('../pages/**/index.astro'))
    .map((f) => f.replace('../pages/', '').replace(/index\.astro$/, '')),
);

const segments = Astro.url.pathname
  .replace(/^\//, '')
  .replace(/\.html$/, '')
  .split('/')
  .filter(Boolean);

/* An index page sits IN the directory its route names; a leaf page sits beside
 * its siblings, one level up. */
const isIndex = INDEX_ROUTES.has(segments.length ? segments.join('/') + '/' : '');
const up = '../'.repeat(isIndex ? segments.length : Math.max(0, segments.length - 1));

/* A page with a second bar of its own — brand-kit's section links — needs both
 * bars to stick as one block, which means one positioned wrapper around them
 * rather than two stuck elements racing for the same top edge. Content in the
 * `navstack` slot is that second bar, and it is what turns the wrapper on: the
 * div cannot be the page's own, because DsNav has to be inside it. The class it
 * carries is styled by whichever page fills the slot. */
/* The stack is unconditional. It used to switch on whether a page filled the
 * `navstack` slot, which meant one page had a second bar and twenty-nine did
 * not -- and the bar it had was seven <li>s written into that page. SubNav
 * renders nothing for a section with no SUB entry, so wrapping every page costs
 * an empty <div> on the pages without one and removes the question entirely. */

/* The import map is the one piece of head that cannot be written as ordinary
 * markup here. Astro does not evaluate {expressions} inside a <script>, so the
 * `up` prefix has to arrive through set:html — and the tag needs is:inline as
 * well, or Astro takes ownership of the script and the map stops being a map.
 *
 * It maps the three bare specifiers the compiled components import. Those files
 * are esbuild output from the site's own toolchain, externalised rather than
 * bundled, so `import { createApp } from 'vue'` survives into the browser and
 * something has to resolve it. Deliberately the vendored copies under
 * docs/vendor/ and NOT the npm ones: a specimen has to render the same when the
 * page is opened from disk, and the vendored vue is the esm-browser build that
 * ships the runtime compiler, which several stories need for slot content. */
const importmapJson = `
{
  "imports": {
    "vue": "${up}vendor/vue.esm-browser.prod.js",
    "gsap": "${up}vendor/gsap/index.js",
    "gsap/SplitText": "${up}vendor/gsap/SplitText.js"
  }
}
`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<link rel="icon" href={`${up}favicons/favicon.svg`}>
<link rel="stylesheet" href={`${up}colors_and_type.css`}>
<link rel="stylesheet" href={`${up}nav.css`}>
{stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
<slot name="head" />
{importmap && <script type="importmap" is:inline set:html={importmapJson} />}
</head>
<body>

<div class="ds-nav-stack">
  <DsNav current={nav} up={up} />
  <SubNav section={nav} current={sub} up={up} />
</div>

<slot />

</body>
</html>
