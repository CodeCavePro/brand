---
/* Ported from docs/kitchen-sink/colors-primary.html (CCWEB2-317 phase 2).
 *
 * The 32 raw-ramp swatches were 32 near-identical 4-line rows differing only in
 * a token name and a caption; they are now three data arrays and a `map`. Every
 * hex is still a literal in this file, which is what the swatch-caption rule in
 * CONTRIBUTING.md requires — the value is the content here, and a `var()` would
 * render an empty string.
 *
 * The five swatches that are NOT ramp steps stay written out: they label a
 * semantic role rather than a token suffix, and three of them carry markup in
 * the caption or a bespoke chip. See docs/components/RampSwatch.astro.
 */
import DocPage from '../../layouts/DocPage.astro';
import RampSwatch from '../../components/RampSwatch.astro';

const brand: [string, string][] = [
  ['brand-25', '#E8E6F0 · gradient endpoint'],
  ['brand-50', '#BBB9CB'],
  ['brand-100', '#B8AFDB'],
  ['brand-200', '#B19AFE · hover fg'],
  ['brand-300', '#735CAB · muted violet'],
  ['brand-400', '#5F3ABD · ring mid-stop (was cyan)'],
  ['brand-500', '#5F20FE · ACTION'],
  ['brand-600', '#4705ED'],
  ['brand-700', '#4004AF · primary hover'],
  ['brand-800', '#1B0D4E · text on CTA'],
  ['brand-900', '#1E113B · primary active · secondary fill'],
  ['brand-950', '#0A0A0B · THE PAGE'],
];

const gray: [string, string][] = [
  ['gray-50', '#F4F4F6 · headings, body'],
  ['gray-100', '#DCDCE5 · resting icon'],
  ['gray-200', '#D5D5DD · long-form copy'],
  ['gray-300', '#C7C7DB · secondary, lighter'],
  ['gray-400', '#A3A3C2'],
  ['gray-500', '#9595BB · metadata, placeholders'],
  ['gray-600', '#6B6699 · neutral · large text only'],
  ['gray-700', '#2B2848 · borders'],
  ['gray-800', '#232339 · surface hover'],
  ['gray-900', '#1C1C27 · raised card'],
  ['gray-950', '#15151E'],
  ['gray-1000', '#050505 · failureproof ground'],
  ['gray-1100', '#0F0F15 · card — lighter than gray-1000'],
];

/* The three raw values production consumes directly. Named in the prose above
 * as the documented exceptions to "never a raw step". */
const accents: [string, string][] = [
  ['glow-25', '#9980FF · glow-button fill'],
  ['shadow-0', '#281470 · the upward glow'],
  ['progress-0', '#8252FC · gradient mid'],
];

const error: [string, string][] = [
  ['error-100', '#FE9A9A · error value text'],
  ['error-200', '#FE2020 · error halo'],
  ['error-300', '#FF6E14 · --color-error'],
  ['error-400', '#CA1400 · nav pulse dot'],
];
---
<DocPage
  title="CODECAVE — Primary color and the raw ramps"
  nav="kitchen-sink"
  stylesheets={['preview.css']}
>
<style slot="head" is:inline>
  /* The dark tail of both ramps is within a few points of the page itself, so
     every chip carries a hairline — without it brand-900/950 and gray-950/1000/1100
     read as one block. */
  .pv-swatch-chip { box-shadow: inset 0 0 0 1px hsl(from #F4F4F6 h s l / 0.14); }
  /* Chip height is per-section: the more important the value, the more area it
     gets. `data-swatches` on the section is the hook, and it exists only for
     these four rules. */
  [data-swatches="action"] .pv-swatch-chip { height: 7rem; }
  [data-swatches="ramp"]   .pv-swatch-chip { height: 4rem; }
  [data-swatches="error"]  .pv-swatch-chip { height: 3.5rem; }
  /* Cyan wash: shown against the page, never against a card, so reviewers
     see the value at the luminance it actually occurs at. */
  [data-swatches="cyan"] .pv-swatch-chip { height: 5rem; }
</style>

<div class="pv-shell">
  <a class="pv-back" href="index.html">&larr; All foundations</a>

  <header class="pv-head">
    <span class="eyebrow">Color · card 1 of 3</span>
    <h1>Primary violet and the raw ramps</h1>
    <p>Verbatim from <code>codecave.pro/src/styles/global.css</code> after the 2026 palette
       rebuild — a violet brand ramp, a gray ramp, and single-use accents. The ramps exist only
       so the semantic names have somewhere to point — consume the semantic layer, never a raw
       step, with the three documented exceptions below.</p>
  </header>

  <section class="pv-block" data-swatches="action">
    <h2>The action color</h2>
    <p class="pv-note">
      <code>#5F20FE</code> edges, links and marks. It never fills a large area. When a genuine
      purple <em>field</em> is needed the system switches to the lighter <code>#9980FF</code> and
      flips to near-black text — the only dark-on-light text anywhere in the system.
    </p>
    <div class="pv-grid pv-grid-3">
      <div class="pv-swatch">
        <div class="pv-swatch-chip" style="background:var(--color-action)"></div>
        <div class="pv-swatch-body">
          <span class="pv-label">Action</span>
          <span class="pv-meta">--color-action<br>#5F20FE · brand-500<br>links · borders · eyebrows · focus halo</span>
        </div>
      </div>
      <div class="pv-swatch">
        <div class="pv-swatch-chip" style="background:var(--color-glow-25);color:var(--color-brand-800);display:grid;place-content:center;font-weight:700">Aa</div>
        <div class="pv-swatch-body">
          <span class="pv-label">Action field</span>
          <span class="pv-meta">--color-glow-25<br>#9980FF + #1B0D4E text<br>the single glow CTA only</span>
        </div>
      </div>
      <div class="pv-swatch">
        <div class="pv-swatch-chip" style="background:var(--color-hovered)"></div>
        <div class="pv-swatch-body">
          <span class="pv-label">Hovered</span>
          <span class="pv-meta">--color-hovered<br>#B19AFE · brand-200<br>hover foreground · focus ring</span>
        </div>
      </div>
      <div class="pv-swatch">
        <div class="pv-swatch-chip" style="background:var(--gradient-brand)"></div>
        <div class="pv-swatch-body">
          <span class="pv-label">Brand gradient</span>
          <span class="pv-meta">--gradient-brand<br>#5F20FE &rarr; #8252FC &rarr; #B19AFE &rarr; #E8E6F0<br>mid stop is progress-0, not brand-300<br>display type · rule accents</span>
        </div>
      </div>
    </div>
  </section>

  <section class="pv-block" data-swatches="cyan">
    <h2>Where the cyan went</h2>
    <p class="pv-note">The 2026 rebuild removed bright cyan <code>#20EFFE</code> from the ramp —
       it survives only inside the decorative SVGs (see the imagery card). The token layer keeps
       one deep cyan, and only inside the technology-card wash.</p>
    <div class="pv-row">
      <div class="pv-swatch" style="width:15rem">
        <div class="pv-swatch-chip" style="background:var(--color-technology-gradient-0)"></div>
        <div class="pv-swatch-body">
          <span class="pv-label">Technology wash</span>
          <span class="pv-meta">--color-technology-gradient-0 · #077689<br>always at 0.1 alpha</span>
        </div>
      </div>
      <p class="pv-warn" style="flex:1;min-width:20rem">
        <strong>Reserved.</strong> The technology card blends
        <code>brand-500 &rarr; brand-400 &rarr; brand-500</code> at low alpha for its ring —
        and since the rebuild <code>brand-400</code> is the violet <code>#5F3ABD</code>, so the
        ring reads violet end to end. Cyan is never a CTA, body color, large field, or
        photographic grade. It is a light effect in the art, not a UI color.
      </p>
    </div>
  </section>

  <section class="pv-block" data-swatches="ramp">
    <h2>Raw ramps — 12 violet steps, 13 grays</h2>
    <p class="pv-note">
      Light to dark. Only three raw values are legitimately consumed directly, because that is
      what production does: <code>glow-25</code> (glow-button fill), <code>shadow-0</code> (the
      upward glow), and <code>progress-0</code> (the gradient mid stop). Two quirks are upstream
      facts: <code>gray-1100</code> (the card) is <em>lighter</em> than <code>gray-1000</code>,
      and <code>brand-500</code> is lighter than <code>brand-400</code>.
    </p>
    <h3 class="pv-label" style="margin:0 0 0.75rem">Brand — violet</h3>
    <div class="pv-grid pv-grid-4">
      {brand.map(([token, meta]) => <RampSwatch token={token} meta={meta} />)}
    </div>
    <h3 class="pv-label" style="margin:1.75rem 0 0.75rem">Gray</h3>
    <div class="pv-grid pv-grid-4">
      {gray.map(([token, meta]) => <RampSwatch token={token} meta={meta} />)}
    </div>
    <h3 class="pv-label" style="margin:1.75rem 0 0.75rem">Single-use accents</h3>
    <div class="pv-grid pv-grid-4">
      {accents.map(([token, meta]) => <RampSwatch token={token} meta={meta} />)}
    </div>
  </section>

  <section class="pv-block" data-swatches="error">
    <h2>Error ramp</h2>
    <p class="pv-note">Four steps. <code>--color-error</code> points at <code>error-300</code>;
       <code>error-100</code> and <code>error-200</code> drive the input error halo, and
       <code>error-400</code> drives the pulsing dot on the last nav item.</p>
    <div class="pv-grid pv-grid-4">
      {error.map(([token, meta]) => <RampSwatch token={token} meta={meta} />)}
    </div>
  </section>
</div>

</DocPage>
