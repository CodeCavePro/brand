    </div>
  </section>

  <section class="sb-group">
    <h2 class="ds-anchor" id="compositions">Compositions</h2>
    <p>Not primitives — assemblies worth documenting because they define styling
       that lives nowhere else.</p>
    <div class="sb-cat">

      <div class="sb-card">
        <div class="thumb sb-mount" inert>
          <div id="t-links"></div>
        </div>
        <a class="meta" href="link-group.html">
          <strong>LinkGroup</strong>
          <span>Heading plus N <code>Button variant="text"</code> — the footer's link styling.</span>
          <code>footer/link-group.vue</code>
        </a>
      </div>

    </div>
  </section>

  <section class="sb-group">
    <h2 class="ds-anchor" id="findings">What this storybook found</h2>
    <p>49 findings across the thirteen components — 23 flagged as defects, 26
       as design observations — each recorded on its own story page. The three
       worth reading first:</p>

    <p class="sb-note is-warn"><strong>Two components animate against a variable they never define.</strong>
      <code>Checkbox.vue</code>:75 and <code>Radio.vue</code>:61 both declare
      <code>transition: var(--default-transition-duration) transform ease-in-out;</code>,
      and <code>--default-transition-duration</code> appears nowhere in the
      project's own code. It resolves anyway — to 150ms from Tailwind's default
      theme, which the build emits because <code>transition-colors</code> is in
      use. Lift either component out of a Tailwind build and the shorthand
      collapses, snapping the indicator instead of easing it.</p>

    <p class="sb-note is-warn"><strong><code>Button</code>'s disabled treatment is unreadable.</strong>
      <code>isDisabled</code> makes the control inert, then composites it to 20%
      opacity — <strong>1.72:1</strong> against the page, below every contrast
      floor there is. What replaces 20% is a design call.</p>

    <p class="sb-note"><strong>Two dead styles.</strong>
      <code>Radio</code>'s secondary hover needs a <code>group</code> ancestor that
      nothing renders, and <code>Button</code>'s <code>type</code> prop is declared
      but never bound.</p>
  </section>

</div>

<script is:inline type="module">
  import { createApp } from 'vue';
  import Button from '../storybook/compiled/Button.js';
  import GlowButton from '../storybook/compiled/GlowButton.js';
  import InputText from '../storybook/compiled/InputText.js';
  import TextField from '../storybook/compiled/TextField.js';
  import Checkbox from '../storybook/compiled/Checkbox.js';
  import Radio from '../storybook/compiled/Radio.js';
  import ArticlePreview from '../storybook/compiled/ArticlePreview.js';
  import Review from '../storybook/compiled/Review.js';
  import TechnologyCard from '../storybook/compiled/technology-card.js';
  import TypingEffect from '../storybook/compiled/TypingEffect.js';
  import PainPointsItem from '../storybook/compiled/pain-points-item.js';
  import LinkGroup from '../storybook/compiled/link-group.js';
  import { usePlaceholders } from '../storybook/placeholders.js';

  // Every thumbnail is the real component at real size (scaled wrappers where
  // it wouldn't fit). The thumbs are `inert` — the card's one control is the
  // stretched .meta link. Full stories and args live on each component's page.
  const mounts = [
    [Button,    't-btn1', { title: 'Primary', class: 'h-11 px-6 py-1' }],
    [Button,    't-btn2', { title: 'Tertiary', variant: 'tertiary' }],
    [GlowButton,'t-glow', { title: 'Book a call' }],
    [InputText, 't-input', { id: 't-input-el', label: 'Email', type: 'email',
                             placeholder: 'you@company.com' }],
    [TextField, 't-textfield', { id: 't-tf-el', label: 'Message',
                                 placeholder: 'Tell us about your project' }],
    [Checkbox,  't-cb1', { id: 't-cb1-el', label: 'I agree',
                           variant: 'primary', size: 'small' }],
    [Checkbox,  't-cb2', { id: 't-cb2-el', label: 'Cloud & DevOps',
                           variant: 'secondary', size: 'small' }],
    [Radio,     't-r1', { id: 't-r1-el', label: '$10–25k', name: 't-budget',
                          isChecked: true, variant: 'primary' }],
    [Radio,     't-r2', { id: 't-r2-el', label: '$25–50k', name: 't-budget',
                          variant: 'primary' }],
    [ArticlePreview, 't-article', { article: {
      slug: 'bim-export-loop',
      cover: { url: '/uploads/bim-export-hero.png', name: 'bim-export-hero.png' },
      date: '2026-04-18',
      locale: 'en-GB',
      title: 'Cutting a BIM export step out of the delivery loop',
      excerpt: 'A manual Revit export sat between the model and the ERP.',
      readingtime: 6,
    } }],
    [Review, 't-review', { item: {
      photo: { name: 'marta-feld.png', url: '/uploads/marta-feld.png' },
      name: 'Marta Feld',
      position: 'CTO, Northwind Logistics',
      review: 'They scoped the smallest thing that would prove the integration worked.',
      linkedinurl: '#!',
      verification: 'Verified on Clutch',
    }, className: '' }],
    [TechnologyCard, 't-tech', { name: 'Cloud & DevOps', active: false,
                                 index: 0, className: 'w-28 h-28' }],
    [TypingEffect, 't-typing', { text1: 'We build software',
                                 text2: 'that survives contact with your business.' }],
    [PainPointsItem, 't-pain', { item: {
      image: { url: '/uploads/pain-icon.svg', name: 'pain-icon.svg' },
