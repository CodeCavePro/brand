---
/* The templates gallery.
 *
 * An Astro page, unlike the six specimens it links to. Those stay hand-written
 * payload under examples/ and are never rendered by Astro -- a specimen with a
 * documentation bar welded to the top stops being the thing it demonstrates.
 * This page is the opposite: it is chrome, it always carried the bar, and while
 * it was payload it carried a SECOND HAND-WRITTEN COPY of that bar. When the bar
 * became a component the copy would have been the only markup left claiming to
 * be the nav while not being it, so the gallery moved into pages/ and the copy
 * is gone. examples/index.html was deleted in the same commit -- a .html at the
 * same path wins over an .astro, so leaving it would have left this file dead.
 *
 * Its route is unchanged: build.format 'preserve' emits pages/examples/
 * index.astro to examples/index.html, which is the href every nav already
 * carries.
 */
import DocPage from '../../layouts/DocPage.astro';
---
<DocPage title="CODECAVE — Templates" nav="examples">

<div class="shell">

  <a class="back" href="../index.html">&larr; Design system</a>

  <p class="eyebrow">Layer 3 — compositions</p>
  <h1>Whole surfaces, built from the system</h1>
  <p class="lead">The layer above components. <code>kitchen-sink/</code> proves a token and
     proves a component; these prove that the two compose
     into something a client actually receives — a deck, a form, an email, a page in
     print. Copy from them; they are not references to check.</p>

  <section>
    <h2>Sales &amp; pitch</h2>
    <p>Surfaces that leave the building. Each is a single self-contained file with no
       build step, so it can be attached, printed or handed over as-is.</p>
    <div class="cards">
      <a class="card" href="deck.html">
        <span class="k">Deck</span>
        <strong>Pitch deck</strong>
        <span>Nine 16:9 slides with keyboard navigation — problem, opportunity,
              product, model, moat, traction and the ask.</span>
        <span class="f">raw/deck.html</span>
      </a>
      <a class="card" href="poster.html">
        <span class="k">Print</span>
        <strong>Poster</strong>
        <span>A 3:4 print-proportioned sheet. The one place the system meets paper,
              and the reason the black-ink logo variants exist.</span>
        <span class="f">raw/poster.html</span>
      </a>
    </div>
  </section>

  <section>
    <h2>Email</h2>
    <p>Table-based layouts with inlined values, because a mail client will not read a
       stylesheet or resolve a custom property. These are the one sanctioned place where
       the token values appear as literals.</p>
    <div class="cards">
      <a class="card" href="email.html">
        <span class="k">Email</span>
        <strong>Marketing email</strong>
        <span>Single-message layout — masthead, one argument, one call to action.
              The closest artifact to the real brand as shipped.</span>
        <span class="f">raw/email.html</span>
      </a>
      <a class="card" href="newsletter.html">
        <span class="k">Email</span>
        <strong>Newsletter digest</strong>
        <span>Multi-story layout built on the three voice pillars — outcome before
              technology, risk named, one low-friction ask.</span>
        <span class="f">raw/newsletter.html</span>
      </a>
    </div>
  </section>

  <section>
    <h2>Web</h2>
    <p>Full pages. These are the system carrying real density — the test of whether the
       200/120 rhythm and the 24px card survive a page with something to say.</p>
    <div class="cards">
      <a class="card" href="landing.html">
        <span class="k">Page</span>
        <strong>Landing page</strong>
        <span>Hero, problem, features, steps, testimonials, FAQ and a closing CTA —
              the long-page test for one primary action.</span>
        <span class="f">raw/landing.html</span>
      </a>
      <a class="card" href="form.html">
        <span class="k">Page</span>
        <strong>Contact form</strong>
        <span>Split-screen capture page with the floating-label field, the violet
              focus halo and a success state.</span>
        <span class="f">raw/form.html</span>
      </a>
    </div>
  </section>

  <p class="note">
    <strong>These were machine-generated and are being brought back onto the brand.</strong>
    They were rendered by the branding-agent engine from <code>brand.json</code>, whose seed
    is correct — but the generator derived its own ten-step palette from it and shipped
    <code>#7040da</code> as the primary. <code>#5F20FE</code> did not appear anywhere in the
    generated token layer. That layer has been removed; these six files are being re-based on
    <code>colors_and_type.css</code> so they resolve through the same tokens as every other
    page in the package.
  </p>

</div>

</DocPage>

<style is:global>

    /* body carries no padding at all — top padding would sit above the sticky
       nav (body's first child) and side padding would inset the bar's own
       background and hairline. Both belong on the shell, whose gutter ladder is
       .page-container's repeated verbatim so its content lines up with the
       nav's; .ds-nav-inner IS a .page-container and is border-box, so this one
       has to be too. */
    body { padding: 0 0 6rem; }
    .shell { box-sizing: border-box; max-width: var(--max-width-desktop);
             margin: 0 auto; padding: 4rem var(--gutter-base) 0; }
    @media (min-width: 768px)  { .shell { padding-inline: var(--gutter-md); } }
    @media (min-width: 1280px) { .shell { padding-inline: var(--gutter-xl); } }

    .back { display: inline-block; margin-bottom: 2.5rem; text-decoration: none;
            color: var(--color-body-secondary-lighter); font-size: var(--text-caption); }
    .back:hover { color: var(--color-heading); }

    .eyebrow { margin: 0 0 0.75rem; color: var(--color-hovered);
               font-size: var(--text-caption); font-weight: var(--font-weight-bold);
               letter-spacing: 0.08em; text-transform: uppercase; }
    h1 { margin: 0; font-size: var(--text-heading-md);
         line-height: var(--text-heading-md--line-height); letter-spacing: -0.02em; }
    .lead { max-width: 68ch; margin: 1.25rem 0 0;
            color: var(--color-body-secondary-lighter);
            font-size: var(--text-md); line-height: var(--leading-md); }
    .lead code { font-family: var(--font-mono); font-size: 0.8125rem;
                 color: var(--color-brand-200); }

    h2 { margin: 0 0 0.5rem; font-size: var(--text-subhead); line-height: var(--leading-subhead); }
    section { margin-top: 4rem; }
    section > p { max-width: 70ch; margin: 0 0 1.75rem;
                  color: var(--color-body-secondary-lighter);
                  font-size: var(--text-caption); line-height: var(--leading-caption); }

    .cards { display: grid; gap: 1rem;
             grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
    .card { display: grid; gap: 0.5rem; align-content: start; padding: 1.75rem 1.75rem 2rem;
            text-decoration: none; border-radius: var(--radius-card);
            background: var(--color-surface-secondary);
            border: 1px solid var(--color-surface-quaternary);
            transition: border-color var(--transition-colors),
                        background var(--transition-colors); }
    .card:hover { background: var(--color-surface-tertiary);
                  border-color: var(--color-action); }
    /* --color-hovered, not --color-action: #5F20FE is 2.94:1 on this ground and
       this is 14px uppercase type. DESIGN.md §10.5. */
    .card .k { color: var(--color-hovered); font-size: var(--text-caption);
               font-weight: var(--font-weight-bold); letter-spacing: 0.08em;
               text-transform: uppercase; }
    .card strong { color: var(--color-heading); font-size: var(--text-subhead);
                   line-height: var(--leading-subhead); font-weight: var(--font-weight-bold); }
    .card span { color: var(--color-body-secondary-lighter);
                 font-size: var(--text-caption); line-height: var(--leading-caption); }
    .card .f { margin-top: 0.375rem; color: var(--color-body-secondary-lighter);
               font-family: var(--font-mono); font-size: 0.75rem; }

    .note { margin-top: 4rem; padding: 1rem 1.25rem; border-radius: var(--radius-control);
            border: 1px solid var(--color-action);
            color: var(--color-body-secondary-lighter);
            font-size: var(--text-caption); line-height: var(--leading-caption); }
    .note strong { color: var(--color-heading); }
    .note code { font-family: var(--font-mono); font-size: 0.8125rem;
                 color: var(--color-hovered); }
</style>
