{
  "name": "@codecavepro/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root. Not published — the publishable package is packages/brand.",
  "license": "Unlicense",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "astro build",
    "preview": "astro preview",
    "build:package": "npm run build --workspace @codecavepro/brand",
    "build:storybook": "node tools/build-storybook.mjs",
    "build:assets": "bash tools/generate-brand-assets.sh",
    "check": "npm run check --workspace @codecavepro/brand && npm run check:ports && npm run check:tw-bridge && npm run check:collisions && npm run check:importmap && npm run check:findings && npm run check:examples && npm run check:links",
    "check:ports": "tsc --noEmit --project docs/storybook/ports/tsconfig.json",
    "check:tw-bridge": "node tools/check-tw-bridge.mjs",
    "check:collisions": "node tools/check-tw-collisions.mjs",
    "check:importmap": "node tools/check-importmap.mjs",
    "check:findings": "node tools/check-findings.mjs",
    "check:examples": "node tools/check-examples.mjs",
    "check:links": "node tools/check-links.mjs",
    "release:package": "npm publish --workspace @codecavepro/brand --access public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.8",
    "@astrojs/vue": "7.0.2",
    "astro": "7.2.4",
    "dompurify": "3.4.14",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41"
  }
}
