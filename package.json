{
  "name": "@codecavepro/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root. Not published — the publishable package is packages/brand.",
  "license": "Unlicense",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @codecavepro/brand",
    "check": "npm run check --workspace @codecavepro/brand && npm run check:ports && node docs/tools/check-tw-bridge.mjs && npm run check:collisions && npm run check:importmap && npm run check:findings && npm run check:examples && npm run check:links",
    "check:importmap": "node docs/tools/check-importmap.mjs",
    "check:findings": "node docs/tools/check-findings.mjs",
    "check:examples": "node docs/tools/check-examples.mjs",
    "check:links": "node docs/tools/check-links.mjs",
    "check:ports": "tsc --noEmit --project docs/storybook/ports/tsconfig.json",
    "check:collisions": "node docs/tools/check-tw-collisions.mjs",
    "check:captures": "node docs/tools/check-captures.mjs",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "release": "npm publish --workspace @codecavepro/brand --access public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/vue": "7.0.2",
    "astro": "7.2.4",
    "dompurify": "3.4.14",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41"
  }
}
