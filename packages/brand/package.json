{
  "name": "@codecavepro/brand",
  "version": "2.1.4",
  "description": "CODECAVE design system — colour, typography and layout tokens as CSS custom properties and as a typed module.",
  "license": "Unlicense",
  "type": "module",
  "homepage": "https://brand.codecave.pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeCavePro/brand.git",
    "directory": "packages/brand"
  },
  "keywords": [
    "codecave",
    "design-system",
    "design-tokens",
    "css-custom-properties"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/colors_and_type.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./components/*": "./dist/src/components/*",
    "./assets/*": "./dist/src/assets/*",
    "./helpers/*": "./dist/src/helpers/*",
    "./lib/*": "./dist/src/lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "gsap": "^3.13.0",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.5",
    "vue": "^3.5.22",
    "vue3-carousel": "^0.17.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "isomorphic-dompurify": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "vue3-carousel": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
